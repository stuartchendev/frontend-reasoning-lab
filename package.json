{
  "name": "frontend-reasoning-lab",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:netlify": "node --env-file=.env ./node_modules/vite/bin/vite.js",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "smoke:lm-studio": "node scripts/smokeLmStudioDiagnosis.mjs",
    "smoke:openai-live": "node --env-file-if-exists=.env scripts/smokeOpenAILiveE2E.mjs"
  },
  "dependencies": {
    "@netlify/functions": "^5.3.0",
    "openai": "^6.48.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@netlify/vite-plugin": "^2.12.9",
    "@vitejs/plugin-react": "^5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
