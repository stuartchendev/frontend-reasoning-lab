# Server-only LM Studio development settings.
# Keep these names unprefixed so Vite does not expose them to browser code.
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=replace-with-your-loaded-model-identifier
# Optional: raise only for slower local architecture-proof models.
LM_STUDIO_TIMEOUT_MS=90000

# Server-only OpenAI setting.
# To select OpenAI, remove both LM_STUDIO_BASE_URL and LM_STUDIO_MODEL.
# The OpenAI model and timeout are currently fixed in the server clients.
# OPENAI_API_KEY=replace-with-your-local-secret
